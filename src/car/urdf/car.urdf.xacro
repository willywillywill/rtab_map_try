<?xml version="1.0"?>
<robot name="show_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pi" value="3.141592653589793"/>

  <material name="body_blue"><color rgba="0.08 0.35 0.80 1"/></material>
  <material name="dark"><color rgba="0.04 0.05 0.07 1"/></material>
  <material name="metal"><color rgba="0.65 0.68 0.72 1"/></material>
  <material name="sensor"><color rgba="0.08 0.85 0.35 1"/></material>

  <!-- base_footprint 位於地面，作為 RViz 的固定座標框架。 -->
  <link name="base_footprint"/>

  <!-- 車身主體。 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.48 0.32 0.12"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.48 0.32 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="8.0"/>
      <inertia ixx="0.0789" ixy="0" ixz="0" iyy="0.1728" iyz="0" izz="0.2229"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- 四個車輪共用的 Xacro 巨集，x、y 代表車輪相對車身的位置。 -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.075" length="0.055"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.075" length="0.055"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.00156" ixy="0" ixz="0" iyy="0.00156" iyz="0" izz="0.00281"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.075"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left_wheel"  x="0.16"  y="0.185"/>
  <xacro:wheel name="front_right_wheel" x="0.16"  y="-0.185"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.16" y="0.185"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.16" y="-0.185"/>

  <!-- 雷射測距儀；掃描資料使用 laser_link 作為 frame_id。 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.055" length="0.05"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.04 0 0.19"/>
  </joint>

  <!-- 相機本體安裝於車身前方。 -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.055 0.10 0.055"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.245 0 0.16"/>
  </joint>

  <!--
    相機光學座標框架遵循 ROS REP-103：
    Z 軸朝鏡頭前方、X 軸向右、Y 軸向下。
  -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963 0 -1.5707963"/>
  </joint>
</robot>
