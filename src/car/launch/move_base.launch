<launch>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/odom"/>
  <!-- rtabmap_slam publishes its 2-D occupancy grid on this private topic. -->
  <arg name="map_topic" default="/grid_map"/>

  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen"
        clear_params="true">

    <rosparam file="$(find car)/config/move_base.yaml"
              command="load"/>

    <rosparam file="$(find car)/config/costmap_common.yaml"
              command="load"
              ns="global_costmap"/>

    <rosparam file="$(find car)/config/costmap_common.yaml"
              command="load"
              ns="local_costmap"/>

    <rosparam file="$(find car)/config/global_costmap.yaml"
              command="load"/>
    <param name="global_costmap/static_layer/map_topic"
           value="$(arg map_topic)"/>

    <rosparam file="$(find car)/config/local_costmap.yaml"
              command="load"/>

    <rosparam file="$(find car)/config/base_local_planner.yaml"
              command="load"/>

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>
</launch>
