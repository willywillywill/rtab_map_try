<?xml version="1.0"?>
<launch>
  <!-- Hardware and motion-control defaults inherited from cmd_try.launch. -->
  <arg name="com_port"   default="/dev/ttyUSB0"/>
  <arg name="lidar_port" default="/dev/ttyUSB1"/>
  <arg name="joy_dev"    default="/dev/input/js0"/>
  <arg name="deadzone"   default="0.05"/>

  <!-- Runtime options. Set localization:=true to reuse an existing database. -->
  <arg name="localization" default="false"/>
  <arg name="database_path" default="$(env HOME)/.ros/rtabmap_lidar.db"/>
  <arg name="use_camera" default="true"/>
  <arg name="use_joy" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="use_rtabmapviz" default="true"/>

  <!-- RPLIDAR: publishes sensor_msgs/LaserScan on /scan. -->
  <node pkg="rplidar_ros" type="rplidarNode" name="rplidarNode" output="screen">
    <param name="serial_port" type="string" value="$(arg lidar_port)"/>
    <param name="serial_baudrate" type="int" value="115200"/>
    <param name="frame_id" type="string" value="laser_link"/>
    <param name="inverted" type="bool" value="false"/>
    <param name="angle_compensate" type="bool" value="true"/>
  </node>

  <!-- Camera is optional because this launch performs LiDAR-only SLAM. -->
  <group if="$(arg use_camera)">
    <include file="$(find astra_camera)/launch/astra_pro.launch">
      <arg name="camera_name" value="camera"/>
      <arg name="depth_align" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_point_cloud_xyzrgb" value="true"/>
      <arg name="enable_color" value="true"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_ir" value="true"/>
    </include>
  </group>

  <!-- Robot model supplies base_link -> laser_link and camera transforms. -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find yahboomcar_description)/urdf/yahboomcar_R2.urdf.xacro'"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="30"/>
  </node>

  <!-- Joystick and motor driver, matching cmd_try.launch. -->
  <group if="$(arg use_joy)">
    <node pkg="joy" type="joy_node" name="joy_node" output="screen">
      <param name="dev" value="$(arg joy_dev)"/>
      <param name="deadzone" value="$(arg deadzone)"/>
      <param name="autorepeat_rate" value="20.0"/>
    </node>
    <node pkg="car" type="joy_controller.py" name="joy_controller" output="screen">
      <param name="max_x" value="1.8"/>
      <param name="max_z" value="1.0"/>
      <param name="linear_axis" value="1"/>
      <param name="angular_axis" value="3"/>
      <param name="invert_linear" value="true"/>
      <param name="invert_angular" value="false"/>
      <param name="wheelbase" value="0.235"/>
      <param name="track_width" value="0.13"/>
      <param name="wheel_radius" value="0.0325"/>
      <param name="max_steering" value="0.6"/>
    </node>
  </group>

  <node pkg="car" type="move.py" name="move_subscriber" output="screen">
    <param name="com_port" value="$(arg com_port)"/>
    <param name="max_vx" value="1.0"/>
    <param name="max_wz" value="1.0"/>
    <param name="invert_vx" value="false"/>
    <param name="invert_wz" value="false"/>
  </node>

  <!-- Wheel/IMU odometry: publishes /odom and odom -> base_link. -->
  <node pkg="car" type="odom_pub.py" name="odom_pub" output="screen">
    <param name="com_port" value="$(arg com_port)"/>
    <param name="baudrate" value="115200"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_link"/>
    <param name="vx_deadband" value="0.05"/>
    <param name="wz_deadband" value="0.05"/>
  </node>

  <!--
    RTAB-Map uses the external odometry above and scan matching for 2D SLAM.
    It publishes map -> odom and the occupancy grid on /grid_map.
  -->
  <node pkg="rtabmap_slam" type="rtabmap" name="rtabmap" output="screen"
        args="$(eval '' if arg('localization') else '--delete_db_on_start')">
    <param name="dataebase_path" value="$(arg database_path)"/>
    <param name="frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="map_frame_id" value="map"/>
    <param name="subscribe_scan" type="bool" value="true"/>
    <param name="subscribe_depth" type="bool" value="fals"/>
    <param name="subscribe_rgb" type="bool" value="false"/>
    <param name="subscribe_rgbd" type="bool" value="false"/>
    <param name="approx_sync" type="bool" value="true"/>
    <param name="queue_size" type="int" value="20"/>

    <param name="Reg/Strategy" value="1"/>
    <param name="Reg/Force3DoF" value="true"/>
    <param name="Icp/Strategy" value="0"/>
    <param name="Icp/VoxelSize" value="0.05"/>
    <param name="Icp/PointToPlane" value="false"/>
    <!-- Grid/Sensor: 0 = 2D laser scan, 1 = depth image, 2 = both. -->
    <param name="Grid/Sensor" type="string" value="0"/>
    <param name="Grid/3D" value="false"/>
    <param name="RGBD/Enabled" value="false"/>
    <param name="Mem/IncrementalMemory" value="true" unless="$(arg localization)"/>
    <param name="Mem/IncrementalMemory" value="false" if="$(arg localization)"/>
    <param name="Mem/InitWMWithAllNodes" value="true" if="$(arg localization)"/>

    <remap from="scan" to="/scan"/>
    <remap from="odom" to="/odom"/>
    <remap from="grid_map" to="/grid_map"/>
  </node>

  <node pkg="rtabmap_viz" type="rtabmap_viz" name="rtabmap_viz"
        if="$(arg use_rtabmapviz)" output="screen">
    <param name="frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="subscribe_scan" type="bool" value="true"/>
    <param name="subscribe_odom_info" type="bool" value="false"/>
    <remap from="scan" to="/scan"/>
    <remap from="odom" to="/odom"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz" if="$(arg use_rviz)"
        args="-d $(find car)/rviz/show_car.rviz -f map" output="screen"/>
</launch>
