<launch>

    <!-- =========================================================
         Raspberry Pi 5 - Optimized YOLO + Astra RGB-D
         ROS Noetic
         ========================================================= -->
       
    <arg name="model"
         default="$(find car)/models/yolo26n_ncnn_model"/>

    <arg name="image_topic"
         default="/camera/color/image_raw"/>

    <arg name="depth_topic"
         default="/camera/depth/image_raw"/>

    <arg name="camera_info_topic"
         default="/camera/color/camera_info"/>

    <!-- YOLO -->
    <arg name="imgsz" default="320"/>
    <arg name="conf" default="0.45"/>
    <arg name="iou" default="0.50"/>
    <arg name="device" default="cpu"/>
    <arg name="max_det" default="30"/>

    <!-- Process every Nth synchronized RGB-D frame.
         1 = maximum YOLO FPS.
         2 = lower CPU load. -->
    <arg name="inference_every_n_frames" default="1"/>

    <!-- Debug output -->
    <arg name="publish_debug_image" default="true"/>
    <arg name="draw_labels" default="true"/>
    <arg name="publish_mask" default="true"/>

    <!-- 0 = publish every inference -->
    <arg name="output_max_fps" default="0.0"/>

    <!-- Depth -->
    <arg name="depth_center_ratio" default="0.40"/>
    <arg name="min_depth" default="0.15"/>
    <arg name="max_depth" default="8.0"/>
    <arg name="depth_sample_step" default="2"/>

    <!-- Pi 5 CPU tuning -->
    <arg name="torch_threads" default="4"/>
    <arg name="opencv_threads" default="2"/>
    <arg name="worker_hz" default="30.0"/>


    <node pkg="car"
          type="yolo_fast.py"
          name="camera_to_yolo"
          output="screen"
          respawn="true"
          respawn_delay="2.0">
       <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1"/>
        <param name="model"
               value="$(arg model)"/>

        <param name="image_topic"
               value="$(arg image_topic)"/>

        <param name="depth_topic"
               value="$(arg depth_topic)"/>

        <param name="camera_info_topic"
               value="$(arg camera_info_topic)"/>

        <param name="imgsz"
               value="$(arg imgsz)"/>

        <param name="conf"
               value="$(arg conf)"/>

        <param name="iou"
               value="$(arg iou)"/>

        <param name="device"
               value="$(arg device)"/>

        <param name="max_det"
               value="$(arg max_det)"/>

        <param name="inference_every_n_frames"
               value="$(arg inference_every_n_frames)"/>

        <param name="publish_debug_image"
               value="$(arg publish_debug_image)"/>

        <param name="draw_labels"
               value="$(arg draw_labels)"/>

        <param name="publish_mask"
               value="$(arg publish_mask)"/>

        <param name="output_max_fps"
               value="$(arg output_max_fps)"/>

        <param name="depth_center_ratio"
               value="$(arg depth_center_ratio)"/>

        <param name="min_depth"
               value="$(arg min_depth)"/>

        <param name="max_depth"
               value="$(arg max_depth)"/>

        <param name="depth_sample_step"
               value="$(arg depth_sample_step)"/>

        <param name="torch_threads"
               value="$(arg torch_threads)"/>

        <param name="opencv_threads"
               value="$(arg opencv_threads)"/>

        <param name="worker_hz"
               value="$(arg worker_hz)"/>

        <!-- Dynamic classes used to generate /yolo/dynamic_mask -->
        <rosparam param="dynamic_classes">
            [
                "person",
                "bicycle",
                "car",
                "motorcycle",
                "bus",
                "truck",
                "dog"
            ]
        </rosparam>

        <!-- Empty = detect all YOLO classes.
             To detect only selected COCO classes, for example:
             <rosparam param="classes">[0, 1, 2, 3, 5, 7]</rosparam>
        -->

    </node>

</launch>
