<launch>
    <arg name="com_port" default="/dev/ttyUSB1" />
    <arg name="lidar_port" default="/dev/ttyUSB0" />
    <arg name="joy_dev" default="/dev/input/js0"/>

    <!-- lidar -->
    <node name="rplidarNode"          pkg="rplidar_ros"  type="rplidarNode" output="screen">
            <param name="serial_port"         type="string" value="$(arg lidar_port)"/>
            <param name="serial_baudrate"     type="int"    value="115200"/>
            <param name="frame_id"            type="string" value="laser_link"/>
            <param name="inverted"            type="bool"   value="false"/>
            <param name="angle_compensate"    type="bool"   value="true"/>
    </node>

    <!-- camera -->
    <include file="$(find astra_camera)/launch/astra_pro.launch">
        <arg name="camera_name" value="camera"/>
        <arg name="depth_align" value="true"/>
        <arg name="enable_point_cloud" value="true"/>
        <arg name="enable_point_cloud_xyzrgb" value="true"/>
        <arg name="enable_color" value="true"/>
        <arg name="enable_depth" value="true"/>
        <arg name="enable_ir" value="true"/>           
    </include>

    <!-- 將 30Hz 的 camera_info 降頻至 5Hz 以配合 yolo_try.py 的處理速度 -->
    <node pkg="topic_tools" type="throttle" name="camera_info_throttler" 
          args="messages /camera/color/camera_info 5.0 /camera/color/camera_info_throttled" />

    <!-- URDF  -->
    <include file="$(find car)/launch/urdf.launch"/>
    <!-- joy_cmd  -->
    <include file="$(find car)/launch/joy_cmd.launch">
        <arg name="com_port" value="$(arg com_port)"/>
        <arg name="joy_dev" value="$(arg joy_dev)"/>
    </include>

    <node 
        pkg="car"
        type="yolo_try.py"
        name="yolo_try">
        <param name="models" value="/ros_ws/src/car/models/yolo26n-seg_ncnn_model"/>
    </node>
   <!-- rtabmap_lidar 

      <include file="$(find car)/launch/rtabmap_try.launch"/>
    -->

</launch>